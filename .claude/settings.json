{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv pip list*)",
      "Bash(uv python list*)",
      "Bash(ffprobe *)",
      "Bash(aic check *)",
      "Bash(gh api repos/*)",
      "Bash(gh search repos *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/secrets/**)",
      "Bash(scp *)",
      "Bash(hf upload *)",
      "Bash(huggingface-cli upload *)",
      "Bash(gh release upload *)",
      "Bash(gh gist create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_media_upload.sh",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
